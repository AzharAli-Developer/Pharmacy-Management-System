<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_medicine_batch_list" model="ir.ui.view">
        <field name="name">pharmacy.medicine.batch.list</field>
        <field name="model">pharmacy.medicine.batch</field>
        <field name="arch" type="xml">
            <list string="Medicine Batches">
                <field name="name"/>
                <field name="medicine_id"/>
                <field name="batch_no"/>
                <field name="supplier_id"/>
                <field name="expiry_date"/>
                <field name="quantity"/>
                <field name="purchase_price"/>
                <field name="stock_value"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_medicine_batch_form" model="ir.ui.view">
        <field name="name">pharmacy.medicine.batch.form</field>
        <field name="model">pharmacy.medicine.batch</field>
        <field name="arch" type="xml">
            <form string="Medicine Batch">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="medicine_id"/>
                            <field name="batch_no"/>
                            <field name="supplier_id"/>
                        </group>
                        <group>
                            <field name="expiry_date"/>
                            <field name="quantity"/>
                            <field name="purchase_price"/>
                            <field name="stock_value"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pharmacy_medicine_batch_search" model="ir.ui.view">
        <field name="name">pharmacy.medicine.batch.search</field>
        <field name="model">pharmacy.medicine.batch</field>
        <field name="arch" type="xml">
            <search string="Search Batches">
                <field name="name"/>
                <field name="medicine_id"/>
                <field name="batch_no"/>
                <filter name="available" string="Available" domain="[('quantity', '&gt;', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_medicine" string="Medicine" context="{'group_by': 'medicine_id'}"/>
                    <filter name="group_supplier" string="Supplier" context="{'group_by': 'supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pharmacy_medicine_batch" model="ir.actions.act_window">
        <field name="name">Medicine Batches</field>
        <field name="res_model">pharmacy.medicine.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
