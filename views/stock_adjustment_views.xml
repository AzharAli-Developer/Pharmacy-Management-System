<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_stock_adjustment_list" model="ir.ui.view">
        <field name="name">pharmacy.stock.adjustment.list</field>
        <field name="model">pharmacy.stock.adjustment</field>
        <field name="arch" type="xml">
            <list string="Stock Adjustments">
                <field name="name"/>
                <field name="date"/>
                <field name="reason"/>
                <field name="user_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_stock_adjustment_form" model="ir.ui.view">
        <field name="name">pharmacy.stock.adjustment.form</field>
        <field name="model">pharmacy.stock.adjustment</field>
        <field name="arch" type="xml">
            <form string="Stock Adjustment">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state == 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes"/>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="state == 'approved'">
                                <list editable="bottom">
                                    <field name="medicine_id"/>
                                    <field name="current_quantity"/>
                                    <field name="new_quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_stock_adjustment" model="ir.actions.act_window">
        <field name="name">Stock Adjustments</field>
        <field name="res_model">pharmacy.stock.adjustment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
