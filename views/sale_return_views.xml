<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_sale_return_list" model="ir.ui.view">
        <field name="name">pharmacy.sale.return.list</field>
        <field name="model">pharmacy.sale.return</field>
        <field name="arch" type="xml">
            <list string="Sale Returns">
                <field name="name"/>
                <field name="sale_id"/>
                <field name="date"/>
                <field name="refund_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_sale_return_form" model="ir.ui.view">
        <field name="name">pharmacy.sale.return.form</field>
        <field name="model">pharmacy.sale.return</field>
        <field name="arch" type="xml">
            <form string="Sale Return">
                <header>
                    <button name="action_confirm_return" type="object" string="Confirm Return" class="btn-primary" invisible="state == 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sale_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="refund_amount"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <field name="reason"/>
                    <notebook>
                        <page string="Returned Medicines">
                            <field name="line_ids" readonly="state == 'confirmed'">
                                <list editable="bottom">
                                    <field name="sale_line_id"/>
                                    <field name="medicine_id"/>
                                    <field name="sold_quantity"/>
                                    <field name="return_quantity"/>
                                    <field name="unit_price"/>
                                    <field name="refund_amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_sale_return" model="ir.actions.act_window">
        <field name="name">Sale Returns</field>
        <field name="res_model">pharmacy.sale.return</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
