<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_customer_list" model="ir.ui.view">
        <field name="name">pharmacy.customer.list</field>
        <field name="model">pharmacy.customer</field>
        <field name="arch" type="xml">
            <list string="Customers">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="sale_count"/>
                <field name="total_medicines_purchased"/>
                <field name="total_spent"/>
                <field name="last_purchase_date"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_customer_form" model="ir.ui.view">
        <field name="name">pharmacy.customer.form</field>
        <field name="model">pharmacy.customer</field>
        <field name="arch" type="xml">
            <form string="Customer">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="sale_count"/>
                            <field name="total_medicines_purchased"/>
                            <field name="total_spent"/>
                            <field name="last_purchase_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="address"/>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Purchase History">
                            <field name="sale_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="sale_date"/>
                                    <field name="customer_name"/>
                                    <field name="total_amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pharmacy_customer_search" model="ir.ui.view">
        <field name="name">pharmacy.customer.search</field>
        <field name="model">pharmacy.customer</field>
        <field name="arch" type="xml">
            <search string="Search Customers">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
            </search>
        </field>
    </record>

    <record id="action_pharmacy_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">pharmacy.customer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
