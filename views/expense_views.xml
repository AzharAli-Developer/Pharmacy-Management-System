<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_expense_list" model="ir.ui.view">
        <field name="name">pharmacy.expense.list</field>
        <field name="model">pharmacy.expense</field>
        <field name="arch" type="xml">
            <list string="Expenses">
                <field name="name"/>
                <field name="expense_type"/>
                <field name="amount"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_expense_form" model="ir.ui.view">
        <field name="name">pharmacy.expense.form</field>
        <field name="model">pharmacy.expense</field>
        <field name="arch" type="xml">
            <form string="Expense">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="expense_type"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pharmacy_expense_kanban" model="ir.ui.view">
        <field name="name">pharmacy.expense.kanban</field>
        <field name="model">pharmacy.expense</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="expense_type"/>
                <field name="amount"/>
                <templates>
                    <t t-name="card">
                        <div class="pharmacy_kanban_card">
                            <strong class="pharmacy_kanban_title"><field name="name"/></strong>
                            <div class="pharmacy_kanban_line"><field name="expense_type"/></div>
                            <div class="pharmacy_kanban_line">Amount: <field name="amount"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_pharmacy_expense_search" model="ir.ui.view">
        <field name="name">pharmacy.expense.search</field>
        <field name="model">pharmacy.expense</field>
        <field name="arch" type="xml">
            <search string="Search Expenses">
                <field name="name"/>
                <field name="expense_type"/>
                <field name="date"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Expense Type" context="{'group_by': 'expense_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pharmacy_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">pharmacy.expense</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
