<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_stock_move_list" model="ir.ui.view">
        <field name="name">pharmacy.stock.move.list</field>
        <field name="model">pharmacy.stock.move</field>
        <field name="arch" type="xml">
            <list string="Stock Movements" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="name"/>
                <field name="medicine_id"/>
                <field name="batch_id"/>
                <field name="move_type"/>
                <field name="quantity"/>
                <field name="previous_stock"/>
                <field name="new_stock"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_stock_move_search" model="ir.ui.view">
        <field name="name">pharmacy.stock.move.search</field>
        <field name="model">pharmacy.stock.move</field>
        <field name="arch" type="xml">
            <search string="Search Stock Movements">
                <field name="name"/>
                <field name="medicine_id"/>
                <field name="date"/>
                <filter name="purchase" string="Purchases" domain="[('move_type', '=', 'purchase')]"/>
                <filter name="sale" string="Sales" domain="[('move_type', '=', 'sale')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_medicine" string="Medicine" context="{'group_by': 'medicine_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'move_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pharmacy_stock_move" model="ir.actions.act_window">
        <field name="name">Stock Movements</field>
        <field name="res_model">pharmacy.stock.move</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
