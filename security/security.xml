<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_pharmacy_management" model="ir.module.category">
        <field name="name">Pharmacy Management</field>
        <field name="description">Manage access to the Pharmacy Management application.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="category_id" ref="module_category_pharmacy_management"/>
    </record>

    <record id="group_owner" model="res.groups">
        <field name="name">Owner</field>
        <field name="category_id" ref="module_category_pharmacy_management"/>
        <field name="implied_ids" eval="[(4, ref('group_employee'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
